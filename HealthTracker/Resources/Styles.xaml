<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Chartwell design system (see docs/DESIGN_SYSTEM.md).

    Every colour comes from a semantic token in Resources/Themes/*.xaml via DynamicResource, so the
    whole app follows light/dark switches without per-page work. Pages should use the keyed styles
    below instead of inline FontSize/TextColor/BackgroundColor; if a new pattern is needed, add it
    here rather than inlining it in a page.

    Spacing scale: 4 / 8 / 12 / 16 / 24.   Corner radius: 14 (inputs, icon tiles) / 20 (cards) / 24 (hero) / pill buttons / 18 (FAB).
    Minimum touch target: 44x44.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Implicit defaults ===================== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource NavBarBackground}"/>
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource NavBarForeground}"/>
        <Setter Property="Shell.TitleColor" Value="{DynamicResource NavBarForeground}"/>
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextDisabled}"/>
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TabBarUnselected}"/>
        <Setter Property="Shell.NavBarHasShadow" Value="False"/>
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource TabBarBackground}"/>
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource TabBarSelected}"/>
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource TabBarSelected}"/>
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TabBarUnselected}"/>
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource NavBarBackground}"/>
        <Setter Property="BarTextColor" Value="{DynamicResource NavBarForeground}"/>
        <Setter Property="IconColor" Value="{DynamicResource NavBarForeground}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextDisabled}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="WidthRequest" Value="44"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="AutoSize" Value="TextChanges"/>
        <Setter Property="MinimumHeightRequest" Value="88"/>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TitleColor" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="CancelButtonColor" Value="{DynamicResource Primary}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Primary}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Primary}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Primary}"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="AppRegular"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Primary}"/>
        <Setter Property="MaximumTrackColor" Value="{DynamicResource Outline}"/>
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}"/>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Primary}"/>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource Outline}"/>
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{DynamicResource Danger}"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="SelectionMode" Value="None"/>
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <!-- ===================== Typography ===================== -->

    <Style x:Key="DisplayText" TargetType="Label">
        <Setter Property="FontFamily" Value="AppExtraBold"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="TitleLarge" TargetType="Label">
        <Setter Property="FontFamily" Value="AppBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="TitleMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="TitleSmall" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="BodyLarge" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="BodyMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="AppMedium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="BodyStrong" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="BodySecondary" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="CaptionStrong" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Overline" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
        <Setter Property="TextColor" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <!-- Section header above a group of cards -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="AppBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="4,18,4,10"/>
    </Style>
    <!-- Big number in a stat tile -->
    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="FontFamily" Value="AppExtraBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
    </Style>
    <Style x:Key="StatUnit" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{DynamicResource Danger}"/>
    </Style>
    <Style x:Key="SuccessText" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{DynamicResource Success}"/>
    </Style>
    <Style x:Key="LinkText" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
    </Style>
    <!-- Label used for a form field's caption, sits above the input -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Margin" Value="4,0,0,6"/>
    </Style>
    <Style x:Key="FieldHint" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="Margin" Value="4,6,0,0"/>
    </Style>

    <!-- ===================== Containers ===================== -->

    <!-- Standard card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}"/>
        <Setter Property="Stroke" Value="{DynamicResource Outline}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- Subtle card on a tinted background, no stroke -->
    <Style x:Key="CardFlat" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- Brand-coloured hero card (Today header, AI banner) -->
    <!-- Gradient hero. Text and icons inside use the OnHero / OnHeroMuted tokens (white in both
         themes); pills inside use the HeroChip style. -->
    <Style x:Key="CardHero" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HeroBrush}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 24"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- Cyan-teal gradient hero for assistant surfaces -->
    <Style x:Key="CardHeroAccent" TargetType="Border" BasedOn="{StaticResource CardHero}">
        <Setter Property="Background" Value="{DynamicResource AccentHeroBrush}"/>
    </Style>
    <!-- Translucent pill placed on a hero card -->
    <Style x:Key="HeroChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource HeroChipFill}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 999"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
    </Style>
    <!-- Quick-action tile: icon tile on top, caption below -->
    <Style x:Key="ActionTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}"/>
        <Setter Property="Stroke" Value="{DynamicResource Outline}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Padding" Value="6,12"/>
        <Setter Property="MinimumHeightRequest" Value="84"/>
    </Style>
    <!-- Tinted status containers -->
    <Style x:Key="CardInfo" TargetType="Border" BasedOn="{StaticResource CardFlat}">
        <Setter Property="BackgroundColor" Value="{DynamicResource InfoContainer}"/>
    </Style>
    <Style x:Key="CardSuccess" TargetType="Border" BasedOn="{StaticResource CardFlat}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SuccessContainer}"/>
    </Style>
    <Style x:Key="CardWarning" TargetType="Border" BasedOn="{StaticResource CardFlat}">
        <Setter Property="BackgroundColor" Value="{DynamicResource WarningContainer}"/>
    </Style>
    <Style x:Key="CardDanger" TargetType="Border" BasedOn="{StaticResource CardFlat}">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerContainer}"/>
    </Style>
    <Style x:Key="CardAccent" TargetType="Border" BasedOn="{StaticResource CardFlat}">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentContainer}"/>
    </Style>
    <!-- Error banner: pair with a Label using ErrorText; bind IsVisible to HasError -->
    <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource CardDanger}">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
    </Style>

    <!-- Container around an Entry/Picker/DatePicker so inputs look consistent -->
    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="Stroke" Value="{DynamicResource Outline}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinimumHeightRequest" Value="52"/>
    </Style>
    <Style x:Key="InputBorderMultiline" TargetType="Border" BasedOn="{StaticResource InputBorder}">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinimumHeightRequest" Value="96"/>
    </Style>

    <!-- Small rounded tag / chip -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 999"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
    </Style>
    <Style x:Key="ChipPrimary" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
    </Style>
    <Style x:Key="ChipSuccess" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SuccessContainer}"/>
    </Style>
    <Style x:Key="ChipWarning" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource WarningContainer}"/>
    </Style>
    <Style x:Key="ChipDanger" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerContainer}"/>
    </Style>
    <Style x:Key="ChipAccent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentContainer}"/>
    </Style>
    <Style x:Key="ChipText" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style x:Key="ChipTextPrimary" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainer}"/>
    </Style>
    <Style x:Key="ChipTextSuccess" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{DynamicResource OnSuccessContainer}"/>
    </Style>
    <Style x:Key="ChipTextWarning" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{DynamicResource OnWarningContainer}"/>
    </Style>
    <Style x:Key="ChipTextDanger" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{DynamicResource OnDangerContainer}"/>
    </Style>
    <Style x:Key="ChipTextAccent" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{DynamicResource OnAccentContainer}"/>
    </Style>

    <!-- Round icon container used as a leading avatar in list rows -->
    <Style x:Key="IconCircle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="WidthRequest" Value="44"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style x:Key="IconCircleLarge" TargetType="Border" BasedOn="{StaticResource IconCircle}">
        <Setter Property="StrokeShape" Value="RoundRectangle 24"/>
        <Setter Property="WidthRequest" Value="72"/>
        <Setter Property="HeightRequest" Value="72"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Thin divider -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="Color" Value="{DynamicResource Outline}"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <!-- ===================== Buttons ===================== -->

    <Style x:Key="PrimaryButton" TargetType="Button"/>

    <!-- Tonal: tinted container, brand text. Secondary actions. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainer}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.8"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
        <Setter Property="BorderColor" Value="{DynamicResource OutlineStrong}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Danger}"/>
        <Setter Property="TextColor" Value="{DynamicResource TextInverse}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="TextColor" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderColor" Value="{DynamicResource Danger}"/>
    </Style>
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Success}"/>
        <Setter Property="TextColor" Value="{DynamicResource TextInverse}"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnAccent}"/>
    </Style>

    <!-- Compact variants for inline row actions (still 40 tall for touch) -->
    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style x:Key="SmallOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style x:Key="SmallTextButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Floating action button: place in the bottom-right of a Grid with Margin 0,0,20,20 -->
    <Style x:Key="Fab" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="WidthRequest" Value="56"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="VerticalOptions" Value="End"/>
        <Setter Property="Margin" Value="0,0,20,20"/>
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource PrimaryBrush}" Opacity="0.35" Radius="16" Offset="0,6"/>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Icon-only button (toolbar-like actions inside pages). Use controls:TintedImageButton with TintColor. -->
    <Style x:Key="IconButton" TargetType="ImageButton"/>

    <!-- Segmented control: a SegmentTrack Border holding equal-width Buttons; the ViewModel exposes one
         bool per segment and the page swaps SegmentButton / SegmentButtonSelected with a DataTrigger. -->
    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 22"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="SegmentButtonSelected" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}"/>
        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
    </Style>

    <!-- Text on a hero card -->
    <Style x:Key="HeroOverline" TargetType="Label" BasedOn="{StaticResource Overline}">
        <Setter Property="TextColor" Value="{DynamicResource OnHeroMuted}"/>
    </Style>
    <Style x:Key="HeroTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="AppExtraBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextColor" Value="{DynamicResource OnHero}"/>
    </Style>
    <Style x:Key="HeroBody" TargetType="Label">
        <Setter Property="FontFamily" Value="AppMedium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource OnHeroMuted}"/>
    </Style>
    <Style x:Key="HeroChipText" TargetType="Label">
        <Setter Property="FontFamily" Value="AppSemibold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{DynamicResource OnHero}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- ===================== Misc ===================== -->

    <Style x:Key="LoadingIndicator" TargetType="ActivityIndicator">
        <Setter Property="IsRunning" Value="True"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="WidthRequest" Value="36"/>
        <Setter Property="HeightRequest" Value="36"/>
    </Style>

    <!-- Rounded, taller progress bar for adherence/day progress -->
    <!-- The bar is scaled up vertically; the view's own background is not, so it must stay transparent
         or it shows as pale bands above and below the bar. -->
    <Style x:Key="ThickProgress" TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="10"/>
        <Setter Property="ScaleY" Value="2.5"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <!-- Form page content padding -->
    <Thickness x:Key="PagePadding">16,12,16,24</Thickness>
    <Thickness x:Key="ListPadding">16,8,16,96</Thickness>
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>

</ResourceDictionary>
