<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:HealthTracker.Controls"
             xmlns:vm="clr-namespace:HealthTracker.ViewModels"
             x:Class="HealthTracker.Views.TimelinePage"
             x:DataType="vm:TimelineViewModel"
             Title="Timeline"
             BackgroundColor="{DynamicResource Background}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="History" IconImageSource="{DynamicResource ToolbarIconHistory}" Order="Primary" Priority="0" Clicked="OnHistoryClicked"/>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- Promotion candidates: TimelineConnector, TimelineDot -->
        <Style x:Key="TimelineConnector" TargetType="BoxView">
            <Setter Property="WidthRequest" Value="2"/>
            <Setter Property="Color" Value="{DynamicResource Outline}"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Fill"/>
        </Style>
        <Style x:Key="TimelineDot" TargetType="Border">
            <Setter Property="WidthRequest" Value="36"/>
            <Setter Property="HeightRequest" Value="36"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Stroke" Value="{DynamicResource Background}"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Start"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Style="{StaticResource ErrorBanner}" Margin="16,8,16,0" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
        </Border>

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{DynamicResource Primary}">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:TimelineGroup">
                        <Label Text="{Binding Month}" Style="{StaticResource Overline}" Margin="16,20,16,8"/>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineItem">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="8" Padding="16,0,16,0">
                            <!-- Rail: connector line behind a coloured icon dot -->
                            <Grid Grid.Column="0">
                                <BoxView Style="{StaticResource TimelineConnector}"/>
                                <Border Style="{StaticResource TimelineDot}"
                                        BackgroundColor="{Binding ColorToken, Converter={StaticResource ThemeColorConverter}}">
                                    <controls:TintedImage Source="{Binding Icon}" Aspect="AspectFit" TintColor="{DynamicResource TextInverse}"/>
                                </Border>
                            </Grid>

                            <!-- Content -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="0,6,0,14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource BodyStrong}"
                                           TextColor="{Binding ColorToken, Converter={StaticResource ThemeColorConverter}}"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="{Binding When}" Style="{StaticResource Caption}" VerticalOptions="Center"/>
                                </Grid>
                                <Label Text="{Binding Caption}" Style="{StaticResource Body}" LineBreakMode="WordWrap" MaxLines="2"/>
                                <Label Text="{Binding SubText}" Style="{StaticResource Caption}" IsVisible="{Binding HasSubText}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid Padding="16,8,16,32" HeightRequest="88">
                        <Button Text="Load more" Style="{StaticResource OutlineButton}" Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding ShowLoadMore}" VerticalOptions="Center"/>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding IsLoadingMore}">
                            <ActivityIndicator Style="{StaticResource LoadingIndicator}" WidthRequest="24" HeightRequest="24"/>
                            <Label Text="Loading older events..." Style="{StaticResource Caption}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <!-- BindingContext is set in code-behind; EmptyView does not reliably inherit the page's. -->
                    <Grid x:Name="EmptyState">
                        <controls:EmptyStateView Icon="ic_timeline.png" Title="Nothing on your timeline yet"
                                                 Message="Doses you take, lab results, vitals, reports and doctor visits will all show up here in order."
                                                 IsVisible="{Binding IsEmpty}"/>
                        <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}"/>
                    </Grid>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
