<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HealthTracker.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:HealthTracker.ViewModels"
             x:Class="HealthTracker.Views.ScanPrescriptionPage"
             x:DataType="vm:ScanPrescriptionViewModel"
             Title="Scan prescription">

    <ContentPage.Resources>
        <!-- Promotion candidate: "StepBadge" numbered circle for stepper UIs. -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
            <Setter Property="WidthRequest" Value="28"/>
            <Setter Property="HeightRequest" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="StepBadgeText" TargetType="Label" BasedOn="{StaticResource CaptionStrong}">
            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainer}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="{StaticResource PagePadding}">

                <!-- Parser mode -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Photograph a prescription and we will pick out the medicines for you to review."
                           Style="{StaticResource BodySecondary}" VerticalOptions="Center"/>
                    <Border Grid.Column="1" Style="{StaticResource ChipAccent}" VerticalOptions="Start" IsVisible="{Binding IsAiConfigured}">
                        <HorizontalStackLayout Spacing="4">
                            <controls:TintedImage Source="ic_auto_awesome.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" TintColor="{DynamicResource OnAccentContainer}"/>
                            <Label Text="AI" Style="{StaticResource ChipTextAccent}"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalOptions="Start" IsVisible="{Binding IsAiConfigured, Converter={StaticResource InverseBoolConverter}}">
                        <Label Text="On-device OCR" Style="{StaticResource ChipText}"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
                </Border>

                <!-- Step 1: image -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Border Style="{StaticResource StepBadge}"><Label Text="1" Style="{StaticResource StepBadgeText}"/></Border>
                            <Label Text="Choose a photo" Style="{StaticResource TitleSmall}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Take photo" Style="{StaticResource SecondaryButton}" Command="{Binding CaptureImageCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Grid.Column="1" Text="Pick image" Style="{StaticResource SecondaryButton}" Command="{Binding PickImageCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="160" IsVisible="{Binding HasImage}"
                                BackgroundColor="{DynamicResource SurfaceVariant}">
                            <Image Source="{Binding PreviewImage}" Aspect="AspectFit" SemanticProperties.Description="Selected prescription photo"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Step 2: progress -->
                <Border Style="{StaticResource CardInfo}" IsVisible="{Binding IsBusy}">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Text="{Binding ProgressText}" Style="{StaticResource Body}" TextColor="{DynamicResource OnInfoContainer}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- AI status / fallback -->
                <Border Style="{StaticResource CardFlat}" IsVisible="{Binding HasAiStatus}">
                    <VerticalStackLayout Spacing="8">
                        <!-- Grid, not HorizontalStackLayout: a stack gives the label infinite width so it never wraps. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <controls:TintedImage Source="ic_info.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" TintColor="{DynamicResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="{Binding AiStatusText}" Style="{StaticResource Caption}"/>
                        </Grid>
                        <Button Text="Open Settings" Style="{StaticResource SmallTextButton}" Command="{Binding OpenSettingsCommand}"
                                HorizontalOptions="Start" IsVisible="{Binding ShowOpenSettings}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Step 3: detected medicines -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasResults}">
                    <HorizontalStackLayout Spacing="10">
                        <Border Style="{StaticResource StepBadge}"><Label Text="2" Style="{StaticResource StepBadgeText}"/></Border>
                        <Label Text="Check the medicines" Style="{StaticResource TitleSmall}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Fix anything the scanner got wrong and untick entries you do not want." Style="{StaticResource Caption}" Margin="4,0,0,0"/>

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ScannedMedicines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScannedMedicineItem">
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Start"
                                                  SemanticProperties.Description="{Binding Name, StringFormat='Include {0}'}"/>
                                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="Name" Style="{StaticResource FieldLabel}"/>
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Name}" Placeholder="Medicine name"/>
                                                </Border>
                                            </VerticalStackLayout>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                    <Label Text="Dosage" Style="{StaticResource FieldLabel}"/>
                                                    <Border Style="{StaticResource InputBorder}">
                                                        <Entry Text="{Binding Dosage}" Placeholder="e.g. 500 mg"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                                    <Label Text="Duration (days)" Style="{StaticResource FieldLabel}"/>
                                                    <Border Style="{StaticResource InputBorder}">
                                                        <Entry Text="{Binding DurationText}" Placeholder="e.g. 7" Keyboard="Numeric"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="Frequency" Style="{StaticResource FieldLabel}"/>
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Frequency}" Placeholder="e.g. Twice daily"/>
                                                </Border>
                                            </VerticalStackLayout>
                                            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center" IsVisible="{Binding HasTimes}"
                                                        BindableLayout.ItemsSource="{Binding Times}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource ChipPrimary}" Padding="8,2" Margin="0,0,6,6">
                                                            <Label Text="{Binding .}" Style="{StaticResource ChipTextPrimary}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                            <Label Text="{Binding MetaText}" Style="{StaticResource Caption}" IsVisible="{Binding HasMeta}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Raw OCR text expander -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasOcrText}">
                    <Button Text="{Binding RawTextToggleText}" Style="{StaticResource SmallTextButton}" Command="{Binding ToggleRawTextCommand}"
                            HorizontalOptions="Start"/>
                    <Border Style="{StaticResource CardFlat}" IsVisible="{Binding ShowRawText}">
                        <Label Text="{Binding OcrText}" Style="{StaticResource Caption}" FontFamily="AppRegular"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Success -->
                <Border Style="{StaticResource CardSuccess}" IsVisible="{Binding SavedSuccessfully}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="10">
                            <controls:TintedImage Source="ic_task_alt.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" TintColor="{DynamicResource Success}"/>
                            <Label Text="Saved to Pending review" Style="{StaticResource TitleSmall}" TextColor="{DynamicResource OnSuccessContainer}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding ResultMessage}" Style="{StaticResource Body}" TextColor="{DynamicResource OnSuccessContainer}"/>
                        <Label Text="Approve each one in Medicines to set its schedule and reminders." Style="{StaticResource Caption}" TextColor="{DynamicResource OnSuccessContainer}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Scan another" Style="{StaticResource OutlineButton}" Command="{Binding ScanAnotherCommand}"/>
                            <Button Grid.Column="1" Text="Review now" Style="{StaticResource SuccessButton}" Command="{Binding ReviewNowCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Step 4: pinned save -->
        <Border Grid.Row="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" StrokeShape="Rectangle" Padding="16,12,16,16"
                IsVisible="{Binding HasResults}">
            <Button Text="Save selected to Pending review" Style="{StaticResource PrimaryButton}" Command="{Binding SaveToPendingCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
        </Border>
    </Grid>
</ContentPage>
