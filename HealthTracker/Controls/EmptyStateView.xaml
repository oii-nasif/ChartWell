<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HealthTracker.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HealthTracker.Controls.EmptyStateView"
             x:Name="Root">
    <VerticalStackLayout Spacing="12" Padding="32,48" HorizontalOptions="Center" VerticalOptions="Center"
                         BindingContext="{x:Reference Root}">
        <Border Style="{StaticResource IconCircleLarge}" HorizontalOptions="Center">
            <controls:TintedImage Source="{Binding Icon}" Aspect="AspectFit" TintColor="{DynamicResource Primary}"/>
        </Border>
        <Label Text="{Binding Title}" Style="{StaticResource TitleMedium}" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding Message}" Style="{StaticResource BodySecondary}" HorizontalTextAlignment="Center"
               IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}"/>
        <Button Text="{Binding ActionText}" Command="{Binding ActionCommand}" Style="{StaticResource SecondaryButton}"
                Margin="0,8,0,0" HorizontalOptions="Center"
                IsVisible="{Binding ActionText, Converter={StaticResource StringNotEmptyConverter}}"/>
    </VerticalStackLayout>
</ContentView>
