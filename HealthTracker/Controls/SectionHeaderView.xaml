<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker.Controls.SectionHeaderView"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto" Margin="4,16,4,8" BindingContext="{x:Reference Root}">
        <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center"/>
        <Button Grid.Column="1" Text="{Binding ActionText}" Command="{Binding ActionCommand}"
                Style="{StaticResource SmallTextButton}" Margin="0,-8,-10,-8"
                IsVisible="{Binding ActionText, Converter={StaticResource StringNotEmptyConverter}}"/>
    </Grid>
</ContentView>
